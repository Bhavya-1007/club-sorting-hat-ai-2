# Server only. Copy to .env.local; never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_DAILY_REQUEST_LIMIT=100
# Global AI admission spacing; busy users get clearly labeled non-AI results.
AI_MIN_INTERVAL_SECONDS=65
# Required for AI on Vercel; optional only for local development (both values required).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
